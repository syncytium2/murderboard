{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup", "hooks": [ { "type": "command", "command": "bash .claude/hooks/session-start.sh", "timeout": 45 } ] },
      { "matcher": "resume",  "hooks": [ { "type": "command", "command": "bash .claude/hooks/session-start.sh", "timeout": 45 } ] }
    ]
  }
}
